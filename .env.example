# Postgres connection string. sqlx tests also read this and need CREATEDB.
DATABASE_URL=postgres://arena:arena@127.0.0.1:5432/arena

# Address the arena process binds. Compose maps host 18480 to container 8080.
BIND_ADDR=0.0.0.0:18480

# Server Ed25519 key lives at $DATA_DIR/keys/server.ed25519 (mode 600).
DATA_DIR=./data

# Stored on the process config. Signing does not read this.
PUBLIC_URL=https://arena.idou.top

# Public site used in connect.sh, connect.ps1, and the GitHub OAuth callback.
# The signing origin is this URL's hostname (production: agent.idou.bid).
# Production: https://agent.idou.bid
PUBLIC_BASE_URL=https://agent.idou.bid

# Force the Secure flag on session cookies. Leave false for plain HTTP.
# Behind Cloudflare, X-Forwarded-Proto or Cf-Visitor already turns it on.
COOKIE_SECURE=false

# Cloudflare Tunnel token. Public hostname agent.idou.bid should ingress to http://arena:8080.
TUNNEL_TOKEN=

# Comma-separated emails that become admin on registration, in addition to the first user.
ADMIN_EMAILS=

# GitHub OAuth App. Leave both empty and the login button returns
# /login?error=github_unconfigured. Callback:
#   ${PUBLIC_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Tests point these at a mock GitHub. Leave unset in production.
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_BASE=https://api.github.com
